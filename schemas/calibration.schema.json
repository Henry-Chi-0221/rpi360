{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpi360.dev/schemas/calibration.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string"
    },
    "coordinate_system": {
      "const": "right-up-back"
    },
    "cameras": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "size": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "intrinsics": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "skew": {
            "type": "number"
          },
          "distortion": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "fov_deg": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 360
          },
          "camera_to_rig": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "minItems": 3,
            "maxItems": 3
          },
          "gain": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "required": [
          "size",
          "intrinsics",
          "skew",
          "distortion",
          "fov_deg",
          "camera_to_rig",
          "gain"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 2
    }
  },
  "required": [
    "schema_version",
    "id",
    "coordinate_system",
    "cameras"
  ],
  "additionalProperties": false
}
