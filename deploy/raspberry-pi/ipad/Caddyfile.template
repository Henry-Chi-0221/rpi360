{
	admin off
	auto_https disable_redirects
	skip_install_trust
	# WebRTC carries video separately; avoid dual-stack QUIC bind conflicts
	# in Debian Caddy 2.6 when binding IPv4 plus the Tailscale IPv6 address.
	servers {
		protocols h1 h2
	}
	storage file_system @@STORAGE@@
	pki {
		ca local {
			name "RPI360 camera"
		}
	}
}

(trusted_network) {
	@outside not remote_ip @@PEER_NETWORKS@@
	respond @outside "This workbench is available on the configured camera networks only." 403
	header X-Content-Type-Options nosniff
}

@@HTTPS_SITES@@ {
	bind @@BIND_HOSTS@@
	tls internal
	route {
		import trusted_network
		header X-Frame-Options DENY
		@bad_origin {
			header Origin *
			not {
@@ORIGINS@@
			}
		}
		respond @bad_origin "Origin is not allowed." 403
		@cross_site_api {
			path /v1/* /api/v1/*
			header Sec-Fetch-Site cross-site
		}
		respond @cross_site_api "Cross-site API requests are not allowed." 403
		handle /healthz {
			respond "RPI360 Pi Workbench" 200
		}
		@api path /v1/* /api/v1/*
		handle @api {
			uri strip_prefix /api
			reverse_proxy 127.0.0.1:8765 {
				header_up Host 127.0.0.1:8765
				header_up -Origin
				header_up -Sec-Fetch-Site
				header_up -Forwarded
				header_up -X-Forwarded-For
				header_up -X-Forwarded-Host
				header_up -X-Forwarded-Proto
				flush_interval -1
			}
		}
		handle {
			root * @@WEB@@
			file_server
		}
	}
}

# Only setup instructions and the public CA certificate are served over HTTP.
@@HTTP_SITES@@ {
	bind @@BIND_HOSTS@@
	route {
		import trusted_network
		@setup path / /index.html /rpi360-ca.crt
		handle @setup {
			root * @@SETUP@@
			header /rpi360-ca.crt Content-Type application/x-x509-ca-cert
			file_server
		}
		handle {
			respond "Open the HTTPS workbench to use the camera." 404
		}
	}
}

https://:8443, http://:8080 {
	bind @@BIND_HOSTS@@
	respond "Unknown camera hostname." 421
}
